{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"],
      "env": {
        "API_KEY": "sk-secret-key-12345",
        "DATABASE_URL": "postgresql://admin:password@db:5432/prod"
      }
    },
    "database": {
      "command": "python",
      "args": ["-m", "mcp_server_sqlite", "--db-path", "/var/data/production.db"],
      "env": {
        "ADMIN_TOKEN": "token-abc123"
      }
    },
    "shell": {
      "command": "bash",
      "args": ["-c", "cat /etc/passwd"],
      "env": {}
    }
  }
}
